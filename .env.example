# Supabase — projeto "Pessoais"
# Copie este arquivo para .env.local e preencha com os valores do seu projeto:
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Senha única do app, conferida no edge da Vercel (middleware.ts).
# SEM o prefixo VITE_ — é o que garante que ela nunca entre no bundle.
# Use uma senha longa: é a única barreira, e não há bloqueio por tentativas.
APP_PASSWORD=escolha-uma-senha-longa
